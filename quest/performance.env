# Quest performance profile. Eye resolution is saved separately in VR Settings.
# Shared NFSU2 paths; NFSU1 live validation is recorded in FEATURE_PARITY.md.
NFSU2_VR_MULTIVIEW=1
NFSU2_VR_FOVEATION=1
NFSU2_VR_SINGLE_SHADER=1
NFSU2_VR_FRAGMENT_SPECIALIZE=1
NFSU2_VR_DYNAMIC_DESCRIPTORS=1
NFSU2_VR_DESCRIPTOR_TEMPLATE=1
NFSU2_VR_COMPACT_BINDINGS=1
NFSU2_VR_LOAD_CLEAR=1
NFSU2_VR_REFRESH_HZ=72
NFSU2_VR_TEXTURE_DECODE=1
RECOMP_PB_SURVEY=0
RECOMP_PB_BULK=1
RECOMP_PB_BULK_VERIFY=1
RECOMP_VK_INSTANCE=0
RECOMP_VK_STATE_CACHE=0
NFSU2_VR_GPU_WAIT=0
NFSU2_VR_GPU_PROFILE=0
NFSU2_VR_CAPTURE=0
NFSU2_VR_IMAGE_BARRIERS=0
NFSU2_VR_FEEDBACK_SWAP=0
NFSU2_VR_VERTEX_LAYOUT=0
NFSU2_VR_DEPTH_LAYOUT=0
